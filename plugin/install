#!/bin/bash
# Builds Settings from this plugin's source and installs it for the current
# user, so it shows up in the app launcher: the binary in ~/.local/bin, the
# launcher entry in ~/.local/share/applications, and the icon beside it. No
# sudo is needed except to add missing build tools, which only happens when
# this runs in a terminal.
#
#   install            build and install (asks to add missing tools)
#   install --status   print one word: current, build, needs-tools, or package
#   install --quiet    build and install without asking; exit 3 if tools are missing
#   install --home D   install under D instead of $HOME (for testing)

set -euo pipefail

SRC="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
TARGET_HOME="$HOME"
MODE=install
QUIET=0

while (( $# > 0 )); do
  case "$1" in
  --status) MODE=status; shift ;;
  --quiet) QUIET=1; shift ;;
  --home) TARGET_HOME="$2"; shift 2 ;;
  -h | --help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) echo "install: unknown option $1" >&2; exit 2 ;;
  esac
done

BIN="$TARGET_HOME/.local/bin/omasettings"
APPS="$TARGET_HOME/.local/share/applications"
ICONS="$TARGET_HOME/.local/share/icons/hicolor/scalable/apps"
STATE="$TARGET_HOME/.local/share/omasettings"
BUILD="${XDG_CACHE_HOME:-$TARGET_HOME/.cache}/omasettings-build"

TOOLS=(gcc make qt6-base qt6-declarative qt6-wayland qt6-imageformats)

# What is being installed: the git commit when the plugin is a checkout, so
# `omarchy plugin update` triggers a rebuild, or the manifest's version.
source_version() {
  git -C "$SRC" rev-parse HEAD 2>/dev/null || jq -r '.version' "$SRC/manifest.json"
}

missing_tools() {
  pacman -T "${TOOLS[@]}" 2>/dev/null | tr "\n" " " | sed "s/ *$//" || true
}

status() {
  # Someone who installed the Arch package keeps it; the plugin doesn't
  # put a second copy ahead of it on the PATH.
  if pacman -Qqo /usr/bin/omasettings >/dev/null 2>&1; then
    echo package
  elif [[ -x $BIN && -f $STATE/installed && $(cat "$STATE/installed") == "$(source_version)" ]]; then
    echo current
  elif [[ -n $(missing_tools) ]]; then
    echo needs-tools
  else
    echo build
  fi
}

if [[ $MODE == status ]]; then
  status
  exit 0
fi

missing=$(missing_tools)
if [[ -n $missing ]]; then
  if (( QUIET )); then
    echo "Settings needs these packages to build: $missing" >&2
    exit 3
  fi
  echo "Settings needs these packages to build:"
  echo "  $missing"
  # shellcheck disable=SC2086
  omarchy-pkg-add $missing
fi

echo "Building Settings…"
mkdir -p "$BUILD"
cd "$BUILD"
qmake6 "$SRC/omasettings.pro" >/dev/null
make -j"$(nproc)" >"$BUILD/build.log" 2>&1 || {
  tail -n 30 "$BUILD/build.log" >&2
  echo "The build failed; the full log is $BUILD/build.log" >&2
  exit 1
}

# Each file is written beside its target and renamed into place, so a
# Settings that is open keeps running and the launcher never sees half a file.
put() {
  local mode="$1" from="$2" to="$3"
  mkdir -p "$(dirname "$to")"
  install -m "$mode" "$from" "$to.new"
  mv -f "$to.new" "$to"
}

put 755 "$BUILD/omasettings" "$BIN"
sed "s|^Exec=omasettings|Exec=$BIN|" "$SRC/pkgbuild/omasettings.desktop" >"$BUILD/omasettings.desktop"
put 644 "$BUILD/omasettings.desktop" "$APPS/omasettings.desktop"
# Settings draws its icon in the theme's colors when it starts; until then
# the packaged one stands in.
[[ -f $ICONS/omasettings.svg ]] || put 644 "$SRC/pkgbuild/omasettings.svg" "$ICONS/omasettings.svg"
put 755 "$SRC/plugin/uninstall" "$STATE/uninstall"
mkdir -p "$STATE"
source_version >"$STATE/installed"

command -v update-desktop-database >/dev/null && update-desktop-database -q "$APPS" 2>/dev/null || true

echo "Settings is installed. Find it in the app launcher (Super + Space)."
